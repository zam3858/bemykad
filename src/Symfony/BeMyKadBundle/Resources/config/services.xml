    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="bemykad.mykad_factory" class="BeMyKad\BeMyKad" shared="false" public="true">
            <argument key="$mykadNumber" type="string" />
